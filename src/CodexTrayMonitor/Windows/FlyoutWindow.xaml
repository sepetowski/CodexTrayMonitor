<Window
    x:Class="CodexTrayMonitor.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CodexTrayMonitor"
    xmlns:core="clr-namespace:CodexTrayMonitor.Core;assembly=CodexTrayMonitor.Core"
    Title="Codex Tray Monitor"
    Width="300"
    Height="286"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    Background="Transparent"
    AllowsTransparency="True"
    Foreground="{DynamicResource Text}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    Focusable="True"
    Deactivated="OnDeactivated"
    KeyDown="OnKeyDown">
    <Window.Resources>
        <local:UsageBrushConverter x:Key="UsageBrush" />
        <Style x:Key="LimitHover" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="15000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LimitHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Percent" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="Renewal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="15000" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource TooltipSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Outline}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,8,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{DynamicResource Track}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="13,8,13,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="1" />
                <RowDefinition Height="10" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CodexTrayMonitor" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource IconButton}"
                        ToolTip="Settings"
                        AutomationProperties.Name="Open settings"
                        Click="SettingsClick"
                        Margin="0,0,12,0">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="M10,2 L14,2 L14.7,5 L16.5,6 L19.3,5.1 L21.3,8.5 L19.2,10.6 L19.2,13.4 L21.3,15.5 L19.3,18.9 L16.5,18 L14.7,19 L14,22 L10,22 L9.3,19 L7.5,18 L4.7,18.9 L2.7,15.5 L4.8,13.4 L4.8,10.6 L2.7,8.5 L4.7,5.1 L7.5,6 L9.3,5 Z"
                                    Stroke="{DynamicResource Secondary}"
                                    StrokeThickness="1.5"
                                    StrokeLineJoin="Round"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Stroke="{DynamicResource Secondary}" StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        ToolTip="Close panel"
                        AutomationProperties.Name="Close panel"
                        Click="CloseClick">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Secondary}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1">
                <Grid>
                    <TextBlock Text="5-hour limit" Style="{StaticResource LimitHeading}" />
                    <TextBlock Text="{Binding FiveHour.PercentText}" Style="{StaticResource Percent}" />
                </Grid>
                <ProgressBar
                    Value="{Binding FiveHour.UsedPercent, TargetNullValue=0}"
                    Foreground="{Binding FiveHour.UsedPercent, Converter={StaticResource UsageBrush}}"
                    AutomationProperties.Name="5-hour limit usage"/>
                <Border
                    x:Name="FiveHourSummary"
                    Style="{StaticResource LimitHover}"
                    Padding="10,6"
                    ToolTip="{Binding ElementName=FiveHourRenewal, Path=ToolTip}">
                    <TextBlock x:Name="FiveHourRenewal" Text="{Binding FiveHour.RenewalText}" Style="{StaticResource Renewal}">
                        <TextBlock.ToolTip>
                            <ToolTip
                                x:Name="FiveHourResetTooltip"
                                Content="{Binding PlacementTarget.DataContext.FiveHour.ExactResetText, RelativeSource={RelativeSource Self}}"/>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="3">
                <Grid>
                    <TextBlock Text="Weekly limit" Style="{StaticResource LimitHeading}" />
                    <TextBlock Text="{Binding Weekly.PercentText}" Style="{StaticResource Percent}" />
                </Grid>
                <ProgressBar
                    Value="{Binding Weekly.UsedPercent, TargetNullValue=0}"
                    Foreground="{Binding Weekly.UsedPercent, Converter={StaticResource UsageBrush}}"
                    AutomationProperties.Name="Weekly limit usage"/>
                <Border x:Name="WeeklySummary" Style="{StaticResource LimitHover}" Padding="10,6" ToolTip="{Binding ElementName=WeeklyRenewal, Path=ToolTip}">
                    <TextBlock x:Name="WeeklyRenewal" Text="{Binding Weekly.RenewalText}" Style="{StaticResource Renewal}">
                        <TextBlock.ToolTip>
                            <ToolTip
                                x:Name="WeeklyResetTooltip"
                                Content="{Binding PlacementTarget.DataContext.Weekly.ExactResetText, RelativeSource={RelativeSource Self}}"/>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </Border>
            </StackPanel>
            <Border Grid.Row="5" Background="{DynamicResource Track}" />
            <Grid
                x:Name="TokenSummary"
                Grid.Row="7"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="Help"
                ToolTip="{Binding ElementName=TokenLabel, Path=ToolTip}"
                ToolTipService.InitialShowDelay="250"
                ToolTipService.ShowDuration="15000">
                <Border CornerRadius="6" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TokenSummary}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TokenLabel"
                        Text="Tokens today"
                        FontSize="11"
                        Foreground="{DynamicResource Secondary}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTipService.InitialShowDelay="250"
                        ToolTipService.ShowDuration="15000">
                        <TextBlock.ToolTip>
                            <ToolTip x:Name="TokensTooltip" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding InputText}" />
                                    <TextBlock Text="{Binding OutputText}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding CachedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock
                        x:Name="TokenValue"
                        Grid.Column="1"
                        Text="{Binding TokensToday}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="{Binding ElementName=TokenLabel, Path=ToolTip}"
                        ToolTipService.InitialShowDelay="250"
                        ToolTipService.ShowDuration="15000"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
