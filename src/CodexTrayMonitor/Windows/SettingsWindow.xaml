<Window
    x:Class="CodexTrayMonitor.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings · Codex Tray Monitor"
    Width="440"
    SizeToContent="Height"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Foreground="{DynamicResource Text}"
    FontFamily="Segoe UI"
    FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    PreviewKeyDown="WindowKeyDown">
    <Window.Resources>
        <Style x:Key="StartupToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border
                                x:Name="Track"
                                Grid.Column="1"
                                Width="36"
                                Height="20"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Track}"
                                BorderBrush="{DynamicResource Outline}"
                                BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2" HorizontalAlignment="Left" Fill="{DynamicResource Secondary}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Primary}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource PrimaryText}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Secondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Focus}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Form" Margin="24,20,24,24">
                <Grid Margin="0,0,0,24" MouseLeftButtonDown="DragHeader">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button
                        x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource QuietButton}"
                        Width="28"
                        Height="28"
                        AutomationProperties.Name="Close settings"
                        Click="CancelClick">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Secondary}" StrokeThickness="1.2" />
                    </Button>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="152" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="AppearanceBox"
                        Grid.Column="1"
                        AutomationProperties.Name="Appearance"
                        SelectedValuePath="Tag"
                        MinHeight="38"
                        SelectionChanged="AppearanceChanged">
                        <ComboBoxItem Content="System" Tag="System" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="AutoStartBox" Style="{StaticResource StartupToggle}" AutomationProperties.Name="Start with Windows" Margin="0,24,0,28">
                    <StackPanel>
                        <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                        <TextBlock Text="Launch automatically when you sign in." FontSize="11.5" Foreground="{DynamicResource Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </CheckBox>
                <TextBlock Text="Codex folder" Style="{StaticResource FormLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="HomeBox"
                        AutomationProperties.Name="Codex folder"
                        TextChanged="HomeChanged"
                        MinHeight="38"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock
                        x:Name="HomePlaceholder"
                        Text="Codex folder not found"
                        IsHitTestVisible="False"
                        Margin="13,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Secondary}"
                        Visibility="Collapsed"/>
                    <Button
                        x:Name="BrowseButton"
                        Grid.Column="2"
                        Height="38"
                        Padding="0"
                        Click="BrowseClick"
                        ToolTip="Choose folder"
                        AutomationProperties.Name="Browse for Codex folder">
                        <Path
                            Width="17"
                            Height="14"
                            Stretch="Uniform"
                            Data="M1,3 L7,3 L9,5 L19,5 L19,16 L1,16 Z M1,6 L19,6"
                            Stroke="{DynamicResource Secondary}"
                            StrokeThickness="1.3"
                            StrokeLineJoin="Round"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="HomeStatus" Foreground="{DynamicResource Secondary}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="HomeHelp"
                    Text="Choose a folder manually or check your Codex installation."
                    FontSize="11.5"
                    Foreground="{DynamicResource Secondary}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Margin="0,4,0,0"/>
                <Button
                    x:Name="AutomaticButton"
                    Content="Detect automatically"
                    Style="{StaticResource QuietButton}"
                    HorizontalAlignment="Left"
                    Margin="-6,8,0,0"
                    Click="AutomaticClick"
                    Visibility="Collapsed"
                    FontSize="11.5"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" Margin="0,8,0,0" />
                <TextBlock
                    x:Name="MonitorStatus"
                    Foreground="{DynamicResource Error}"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Visibility="Collapsed"
                    Margin="0,8,0,0"
                    AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="CancelClick" MinWidth="88" Height="36" />
                    <Button
                        x:Name="SaveButton"
                        Content="Save"
                        IsDefault="True"
                        Click="SaveClick"
                        Margin="8,0,0,0"
                        MinWidth="88"
                        Height="36"
                        Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
